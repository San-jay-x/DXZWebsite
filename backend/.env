# ========================================
# DXZ Data Manager Environment Configuration
# ========================================

# ----- Server Configuration -----
NODE_ENV=development
PORT=5000

# ----- Frontend URL (for CORS) -----
FRONTEND_URL=http://localhost:3000

# ----- MongoDB Database Configuration -----
# Using local MongoDB (already installed and running)
MONGO_URI=mongodb://localhost:27017/dxz-data-manager

# ----- JWT Configuration -----
JWT_SECRET=b7740c91fecafbe24c84ac7dafbcf584a0ad533ee7c5b8f434cdf424a7376c0f8bcc0456a8c2e7f1fdc31771b232bed16f004ea7f05e0982433f6908f0b357ba
JWT_EXPIRES_IN=7d

# ----- Email Configuration (Gmail SMTP) -----
# ⚠️  PLEASE UPDATE THESE WITH YOUR GMAIL CREDENTIALS
# Follow the setup guide in SETUP-GUIDE.md for detailed instructions

EMAIL_FROM=your-gmail@gmail.com
EMAIL_FROM_NAME=DXZ Data Manager

# Gmail SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password

# ----- Email Templates Configuration -----
CLIENT_URL=http://localhost:3000

# ========================================
# 🚨 IMPORTANT: UPDATE EMAIL SETTINGS
# ========================================
# 
# The application will work for all features EXCEPT email sending
# until you configure Gmail SMTP properly.
# 
# TO CONFIGURE GMAIL SMTP:
# 1. Enable 2FA on your Gmail account
# 2. Generate an App Password for "DXZ Data Manager"
# 3. Replace EMAIL_USER with your Gmail address
# 4. Replace EMAIL_PASS with your 16-character app password
# 5. Replace EMAIL_FROM with your Gmail address
# 
# See SETUP-GUIDE.md for detailed step-by-step instructions.