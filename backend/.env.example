# ========================================
# DXZ Data Manager Environment Configuration
# ========================================

# ----- Server Configuration -----
NODE_ENV=development
PORT=5000

# ----- Frontend URL (for CORS) -----
FRONTEND_URL=http://localhost:3000

# ----- MongoDB Database Configuration -----
# Option 1: MongoDB Atlas (Cloud - Recommended)
# Get your connection string from MongoDB Atlas:
# 1. Go to https://cloud.mongodb.com
# 2. Create account and cluster
# 3. Get connection string and replace <password> with your password
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/dxz-data-manager?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/dxz-data-manager

# ----- JWT Configuration -----
# Generate a strong random string for JWT secret
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration (e.g., '1h', '7d', '30d')
JWT_EXPIRES_IN=7d

# ----- Email Configuration (Gmail SMTP) -----
# Follow Gmail setup instructions below
EMAIL_FROM=your-app-name@gmail.com
EMAIL_FROM_NAME=DXZ Data Manager

# Gmail SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# ----- Email Templates Configuration -----
# Base URL for email links (usually your frontend URL)
CLIENT_URL=http://localhost:3000

# ========================================
# SETUP INSTRUCTIONS
# ========================================

# 📧 GMAIL SMTP SETUP INSTRUCTIONS:
# 
# 1. Enable 2-Factor Authentication on your Gmail account:
#    - Go to https://myaccount.google.com/security
#    - Turn on 2-Step Verification
#
# 2. Generate App Password:
#    - Go to https://myaccount.google.com/apppasswords
#    - Select app: Mail
#    - Select device: Other (Custom name) -> "DXZ Data Manager"
#    - Copy the 16-character password (remove spaces)
#    - Use this password in EMAIL_PASS (not your regular Gmail password)
#
# 3. Update the following variables:
#    EMAIL_USER=your-gmail@gmail.com
#    EMAIL_PASS=abcd-efgh-ijkl-mnop  (your app password)
#    EMAIL_FROM=your-gmail@gmail.com
#
# 4. Test email sending by registering a new user account

# 🗄️ MONGODB SETUP INSTRUCTIONS:
#
# OPTION 1 - MongoDB Atlas (Cloud, Recommended):
# 1. Go to https://cloud.mongodb.com and create account
# 2. Create a new cluster (free tier available)
# 3. Create database user:
#    - Go to Database Access
#    - Add new user with username/password
#    - Give "Read and write to any database" permission
# 4. Configure network access:
#    - Go to Network Access
#    - Add IP Address: 0.0.0.0/0 (allow from anywhere) for development
#    - For production, add specific IP addresses
# 5. Get connection string:
#    - Go to Database -> Connect
#    - Choose "Connect your application"
#    - Copy connection string
#    - Replace <password> with your database user password
#    - Update MONGO_URI above
#
# OPTION 2 - Local MongoDB:
# MongoDB is already installed locally. To use it:
# 1. Start MongoDB: sudo mongod --fork --logpath /var/log/mongodb/mongod.log
# 2. Use: MONGO_URI=mongodb://localhost:27017/dxz-data-manager
#
# Verify MongoDB is running: mongosh (then type 'exit' to quit)

# 🔐 SECURITY NOTES:
# - Never commit .env file to version control
# - Use strong, unique passwords
# - In production, use environment variables instead of .env file
# - Regularly rotate JWT secret and app passwords
# - Use specific IP addresses for MongoDB network access in production

# 🚀 AFTER CONFIGURATION:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update all the values with your actual credentials
# 3. Install dependencies: npm install
# 4. Start the server: npm run dev
# 5. Test by registering a new user (should send verification email)